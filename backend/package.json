{
  "name": "filmlog-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/database/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/database/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "jsonwebtoken": "9.0.3"
  }
}
